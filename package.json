{
  "name": "@lmq00/superagent-lite",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Project-scoped router and worker delegation for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMQ00/superagent-lite.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./router": "./router.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "router.js",
    "cordis.patch.yml",
    "scripts",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "client.js"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
