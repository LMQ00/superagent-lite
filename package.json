{
  "name": "@local/superagent-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project-scoped router and worker delegation for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./router": "./router.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "router.js",
    "cordis.patch.yml",
    "scripts",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "client.js"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <=0.2.3-alpha.1"
  }
}
